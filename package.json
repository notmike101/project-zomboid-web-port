{
  "name": "project-zomboid-web-port",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.10.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "npm run lint && cargo fmt --manifest-path engine/Cargo.toml -- --check && cargo clippy --manifest-path engine/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path engine/Cargo.toml && npm test && npm run docs:check",
    "release": "npm run build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@notmike101/eslint-config-js": "file:vendor/notmike101-eslint-config-js-4.0.5.tgz",
    "@notmike101/eslint-config-jsdoc": "file:vendor/notmike101-eslint-config-jsdoc-1.0.1.tgz",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-sort-class-members": "1.22.1",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.5.0"
  },
  "dependencies": {
    "wasmoon": "file:vendor/wasmoon-1.16.0.tgz"
  }
}
