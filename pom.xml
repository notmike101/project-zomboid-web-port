<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>local.experiment</groupId>
  <artifactId>zomboid-bytecode-probe</artifactId>
  <version>1.0</version>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.16.0</teavm.version>
    <probe.mainClass>probe.AngleProbe</probe.mainClass>
    <probe.output>${project.basedir}/target/angles</probe.output>
  </properties>
  <dependencies>
    <dependency>
      <groupId>local.proprietary</groupId><artifactId>projectzomboid</artifactId><version>installed</version>
      <scope>system</scope><systemPath>${game.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>${teavm.version}</version>
    </dependency>
  </dependencies>
  <build>
    <directory>${probe.output}</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>${teavm.version}</version>
        <executions>
          <execution>
            <goals><goal>compile</goal><goal>copy-webassembly-gc-runtime</goal></goals>
            <phase>process-classes</phase>
          </execution>
        </executions>
        <configuration>
          <mainClass>${probe.mainClass}</mainClass>
          <targetType>WEBASSEMBLY_GC</targetType>
          <targetDirectory>${project.build.directory}/wasm</targetDirectory>
          <targetFileName>probe.wasm</targetFileName>
          <optimizationLevel>SIMPLE</optimizationLevel>
          <minifying>false</minifying>
          <strict>true</strict>
          <debugInformationGenerated>true</debugInformationGenerated>
          <sourceMapsGenerated>true</sourceMapsGenerated>
          <sourceFilesCopied>false</sourceFilesCopied>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
